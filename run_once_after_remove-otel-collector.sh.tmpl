#!{{ lookPath "bash" }}
# Remove what the OTel collector pipeline installed, now that the pipeline is
# gone from this repo. chezmoi doesn't delete a file that leaves the source.
# Safe on any machine: each step runs only where its target exists.
# Keeps ~/.local/share/otel/data/ (claude.db, the only copy of the telemetry).
# A stop runs only for what is there: the timer if it is enabled, the
# container if docker reports it. A failed stop deletes nothing and exits
# non-zero, so chezmoi runs this again on the next apply.

set -uo pipefail

otel="$HOME/.local/share/otel"
units="$HOME/.config/systemd/user"
did=false
keep_compose=false
failed=()

# 1. Stop the ingest timer, if it was enabled, before its unit files go.
if [ -L "$units/timers.target.wants/otel-ingest.timer" ] && command -v systemctl >/dev/null 2>&1; then
  systemctl --user disable --now otel-ingest.timer || failed+=("the otel-ingest timer")
fi

# 2. Remove the collector container, if docker reports it. It restarts with
# docker (restart: unless-stopped), so stopping it is not enough.
container=otelcol-claude
if command -v docker >/dev/null 2>&1; then
  if docker info >/dev/null 2>&1; then
    if docker container inspect "$container" >/dev/null 2>&1; then
      docker rm -f "$container" >/dev/null || failed+=("the $container container")
    fi
  elif [ -e "$otel/.env" ]; then
    # The install script got far enough to write .env, so the container may
    # exist; it restarts with docker and bind-mounts config.yaml. Without
    # docker there is no telling, so its files stay, the apply goes on, and
    # the warning says what to do once docker runs.
    keep_compose=true
    echo "OTel removal: docker is not reachable, so the $container container was not checked." >&2
    echo "  Its files stay in $otel. Once docker runs: docker rm -f $container; rm $otel/{compose.yml,config.yaml,.env}" >&2
  fi
fi

if [ "${#failed[@]}" -gt 0 ]; then
  echo "OTel removal: could not stop: ${failed[*]}. Nothing deleted; the next chezmoi apply tries again." >&2
  exit 1
fi

# 3. Remove the deployed files; the data folder stays.
for f in "$units/otel-ingest.service" "$units/otel-ingest.timer" \
         "$HOME/.local/bin/otel-stats" \
         "$otel/compose.yml" "$otel/config.yaml" "$otel/ingest.py" \
         "$otel/backfill.py" "$otel/schema.sql" "$otel/.env"; do
  case "$f" in
    "$otel/compose.yml"|"$otel/config.yaml"|"$otel/.env")
      [ "$keep_compose" = false ] || continue ;;
  esac
  if [ -e "$f" ]; then
    rm -f -- "$f"
    did=true
  fi
done
if [ "$did" = true ] && command -v systemctl >/dev/null 2>&1; then
  systemctl --user daemon-reload 2>/dev/null || true
fi
rmdir -- "$otel" 2>/dev/null || true

if [ "$did" = true ]; then
  echo 'OTel collector pipeline removed.'
  if [ -d "$otel/data" ]; then
    echo "Kept $otel/data/ (claude.db). Archive or delete it by hand."
  fi
fi
exit 0
