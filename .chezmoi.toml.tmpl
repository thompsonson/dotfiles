{{- /* Termux reports os "linux" with no /etc/os-release. Detect it via the
       TERMUX_VERSION env var or the Termux prefix directory. */ -}}
{{- $isTermux := false -}}
{{- if env "TERMUX_VERSION" -}}{{- $isTermux = true -}}{{- end -}}
{{- if stat "/data/data/com.termux/files/usr" -}}{{- $isTermux = true -}}{{- end -}}

{{- $osID := .chezmoi.os -}}
{{- if $isTermux -}}
{{-   $osID = "linux-termux" -}}
{{- else if (and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id")) -}}
{{-   $osID = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}


{{- /* Personal values kept out of tracked files (this repo is public).
       promptStringOnce only prompts the first time chezmoi init/apply runs on
       a machine; after that it reuses the value already in .chezmoi.toml. */ -}}
{{- $email := promptStringOnce . "email" "Git/GPG/SSH email address" "" -}}
{{- $tailnetDomain := promptStringOnce . "tailnet_domain" "Tailscale tailnet domain for the OTel collector host (blank to skip remote telemetry)" "" -}}
{{- $employerName := promptStringOnce . "employer_name" "Employer name, full (blank to omit from docs)" "" -}}
{{- $employerShort := promptStringOnce . "employer_short" "Employer name, short form" "" -}}
{{- $role := promptStringOnce . "role" "Your role at the employer" "" -}}

[data]
    osid = {{ $osID | quote }}
    is_termux = {{ $isTermux }}
    install_nix = {{ if and (eq .chezmoi.os "linux") (not $isTermux) }}true{{ else }}false{{ end }}
    email = {{ $email | quote }}
    tailnet_domain = {{ $tailnetDomain | quote }}
    employer_name = {{ $employerName | quote }}
    employer_short = {{ $employerShort | quote }}
    role = {{ $role | quote }}
