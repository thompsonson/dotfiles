# Default settings for all hosts
Host *
  AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
  IgnoreUnknown UseKeychain
  UseKeychain yes
{{- end }}
  IdentityFile ~/.ssh/id_ed25519
  ServerAliveInterval 60
  ServerAliveCountMax 3

{{ $collector := index . "collector_host" | default "" -}}
{{- if $collector }}
# The collector host
Host {{ $collector }}
  HostName {{ $collector }}
  User mt
  IdentityFile ~/.ssh/id_ed25519
{{- end }}

# GitHub
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519

# GitLab
Host gitlab.com
  HostName gitlab.com
  User git
  IdentityFile ~/.ssh/id_ed25519

# Mac
Host mac mac.local
  HostName mac.local
  User mthompson
  IdentityFile ~/.ssh/id_ed25519
