# Default settings for all hosts
Host *
  AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
  IgnoreUnknown UseKeychain
  UseKeychain yes
{{- end }}
  IdentityFile ~/.ssh/id_ed25519
  ServerAliveInterval 60
  ServerAliveCountMax 3
{{- if not (hasKey . "collector_host") }}{{ fail "collector_host is not set: run chezmoi init, which asks for it once" }}{{ end }}
{{- $collector := .collector_host }}
{{- if $collector }}

# The collector host
Host {{ $collector }}
  HostName {{ $collector }}
  User mt
  IdentityFile ~/.ssh/id_ed25519
{{- end }}

# GitHub
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519

# GitLab
Host gitlab.com
  HostName gitlab.com
  User git
  IdentityFile ~/.ssh/id_ed25519

# Mac
Host mac mac.local
  HostName mac.local
  User mthompson
  IdentityFile ~/.ssh/id_ed25519
