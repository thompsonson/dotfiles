#!{{ lookPath "bash" }}
{{ if and (eq .chezmoi.os "linux") (not .is_termux) -}}
# Upgrade to gpg >= 2.4 via the official GnuPG project apt repository.
#
# Ubuntu/Debian LTS releases freeze gpg's major.minor at whatever shipped
# with the release (security patches only) — jammy (22.04) ships 2.2.27,
# Debian 12 "bookworm" ships 2.2.40. Neither reaches 2.4, which several
# devagent provisioning paths (dev --provision --role, ADR 007 §3/§10) now
# hard-require. The GnuPG project publishes its own signed apt repo per
# distro codename; this adds it and upgrades, but only when the installed
# gpg is actually old.
#
# Idempotent: skips entirely (no apt-source changes at all) once gpg is
# already >= 2.4 — most future hosts on a newer distro release will satisfy
# this immediately and never touch apt config. Fails soft throughout: a
# codename repos.gnupg.org doesn't publish, a network hiccup, or a signing-
# key mismatch all skip with a warning rather than breaking chezmoi apply.

set -u

if ! command -v apt-get >/dev/null 2>&1; then
  exit 0   # not an apt-based Linux — nothing to do
fi
if ! command -v gpg >/dev/null 2>&1; then
  exit 0   # run_once_install-packages.sh.tmpl installs gpg; nothing to upgrade yet
fi

gpg_version() {
  gpg --version 2>/dev/null | head -1 | awk '{print $NF}'
}

# $1 = installed "X.Y[.Z]", $2 = required "X.Y" — fails closed on garbage.
version_at_least() {
  local have="$1" want="$2"
  local have_major have_minor want_major want_minor
  have_major="${have%%.*}"
  have_minor="${have#*.}"; have_minor="${have_minor%%.*}"
  want_major="${want%%.*}"
  want_minor="${want#*.}"
  case "$have_major" in ''|*[!0-9]*) return 1 ;; esac
  case "$have_minor" in ''|*[!0-9]*) have_minor=0 ;; esac
  [ "$have_major" -gt "$want_major" ] && return 0
  [ "$have_major" -eq "$want_major" ] && [ "$have_minor" -ge "$want_minor" ]
}

current="$(gpg_version)"
if version_at_least "${current:-0}" "2.4"; then
  echo "gpg $current already >= 2.4 — skipping GnuPG repo add"
  exit 0
fi

echo "gpg $current is older than 2.4 — adding the official GnuPG apt repo to upgrade"

# shellcheck disable=SC1091
. /etc/os-release 2>/dev/null || true
codename="${VERSION_CODENAME:-}"
if [ -z "$codename" ]; then
  echo "warning: could not detect VERSION_CODENAME from /etc/os-release — skipping GnuPG repo add" >&2
  exit 0
fi

KEY_URL="https://repos.gnupg.org/deb/gnupg/${codename}/gnupg-signing-key.gpg"
KEYRING="/usr/share/keyrings/gnupg-keyring.gpg"
EXPECTED_FPR="32097B719B3745D6E61DDA1B85C45AE3E1A2B355"

# A codename repos.gnupg.org doesn't publish yet (or a network hiccup) must
# not break the rest of chezmoi apply — skip, don't fail.
if ! curl -fsSL "$KEY_URL" 2>/dev/null | sudo gpg --dearmor --yes --output "$KEYRING" 2>/dev/null; then
  echo "warning: could not fetch/import the GnuPG signing key for '$codename' from $KEY_URL — skipping (repos.gnupg.org may not publish this codename yet)" >&2
  exit 0
fi
sudo chmod a+r "$KEYRING"

# Verify the imported key's fingerprint before trusting it for package
# installs — don't take the download on faith.
got_fpr="$(gpg --no-default-keyring --keyring "$KEYRING" --with-colons --fingerprint 2>/dev/null \
  | awk -F: '/^fpr:/{print $10; exit}')"
if [ "$got_fpr" != "$EXPECTED_FPR" ]; then
  echo "warning: GnuPG signing key fingerprint mismatch (got '${got_fpr:-none}', expected '$EXPECTED_FPR') — removing keyring, skipping repo add" >&2
  sudo rm -f "$KEYRING"
  exit 0
fi

sudo tee /etc/apt/sources.list.d/gnupg.sources >/dev/null <<EOF
Types: deb
URIs: https://repos.gnupg.org/deb/gnupg/${codename}/
Suites: ${codename}
Components: main
Signed-By: ${KEYRING}
EOF

sudo apt-get update -qq
if sudo apt-get install -y --only-upgrade gpg gnupg gnupg2 gpg-agent dirmngr 2>&1; then
  gpgconf --kill gpg-agent 2>/dev/null || true
  echo "gpg upgraded: $current -> $(gpg_version)"
else
  echo "warning: gpg upgrade via the GnuPG repo did not complete cleanly — check 'sudo apt-get install --only-upgrade gnupg' manually" >&2
fi
{{ end -}}
