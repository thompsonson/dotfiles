{{- /* Renders, so runs and shows in chezmoi status, only while something the OTel pipeline installed is left; empty, chezmoi skips it. */ -}}
{{- $left := false -}}
{{- range list ".config/systemd/user/timers.target.wants/otel-ingest.timer" ".config/systemd/user/otel-ingest.service" ".config/systemd/user/otel-ingest.timer" ".local/bin/otel-stats" ".local/share/otel/ingest.py" ".local/share/otel/backfill.py" ".local/share/otel/schema.sql" ".local/share/otel/compose.yml" ".local/share/otel/config.yaml" ".local/share/otel/.env" -}}
{{-   if lstat (joinPath $.chezmoi.homeDir .) }}{{ $left = true }}{{ end -}}
{{- end -}}
{{- if $left -}}
#!{{ lookPath "bash" }}
# Remove what the OTel collector pipeline installed, now that the pipeline is
# gone from this repo. chezmoi doesn't delete a file that leaves the source.
#
# A run_ script, so what it can't finish now it finishes on a later apply.
# The template renders only while something is left; once nothing is, it is
# empty, and chezmoi neither runs it nor lists it in chezmoi status.
#
# - The ingest timer is disabled if it is enabled.
# - The collector container is removed if docker reports it. Docker is asked
#   only while the install script's .env exists: no .env, no container.
# - If docker can't be reached, the container's files stay (it bind-mounts
#   config.yaml), a warning is printed, and the next apply asks again.
# - A failed disable or removal deletes nothing and fails the apply.
# - ~/.local/share/otel/data/ (claude.db, the only copy) is never touched.
#
# Delete this script once every machine is clean.

set -uo pipefail

otel="$HOME/.local/share/otel"
units="$HOME/.config/systemd/user"
container=otelcol-claude
keep_compose=false
failed=()
did=false

# 1. Disable the ingest timer, if enabled, before its unit files go.
if [ -L "$units/timers.target.wants/otel-ingest.timer" ] && command -v systemctl >/dev/null 2>&1; then
  systemctl --user disable --now otel-ingest.timer || failed+=("the otel-ingest timer")
fi

# 2. Remove the collector container. It restarts with docker
# (restart: unless-stopped), so stopping it is not enough.
if [ -e "$otel/.env" ] && command -v docker >/dev/null 2>&1; then
  if docker info >/dev/null 2>&1; then
    if docker container inspect "$container" >/dev/null 2>&1; then
      docker rm -f "$container" >/dev/null || failed+=("the $container container")
    fi
  else
    keep_compose=true
    echo "OTel removal: docker is not reachable, so the $container container was not checked." >&2
    echo "  Its files stay in $otel; the next chezmoi apply checks again." >&2
  fi
fi

if [ "${#failed[@]}" -gt 0 ]; then
  echo "OTel removal: could not stop: ${failed[*]}. Nothing deleted; the next chezmoi apply tries again." >&2
  exit 1
fi

# 3. Remove the deployed files; the data folder stays.
for f in "$units/otel-ingest.service" "$units/otel-ingest.timer" \
         "$HOME/.local/bin/otel-stats" \
         "$otel/ingest.py" "$otel/backfill.py" "$otel/schema.sql" \
         "$otel/compose.yml" "$otel/config.yaml" "$otel/.env"; do
  case "$f" in
    "$otel/compose.yml"|"$otel/config.yaml"|"$otel/.env")
      [ "$keep_compose" = false ] || continue ;;
  esac
  if [ -e "$f" ]; then
    rm -f -- "$f"
    did=true
  fi
done
if [ "$did" = true ] && command -v systemctl >/dev/null 2>&1; then
  systemctl --user daemon-reload 2>/dev/null || true
fi
rmdir -- "$otel" 2>/dev/null || true

if [ "$did" = true ] && [ "$keep_compose" = false ]; then
  echo 'OTel collector pipeline removed.'
  if [ -d "$otel/data" ]; then
    echo "Kept $otel/data/ (claude.db). Archive or delete it by hand."
  fi
fi
exit 0
{{ end -}}
